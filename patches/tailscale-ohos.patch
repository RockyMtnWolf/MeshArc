+func (p *outgoingProgress) update(file ipn.OutgoingFile) {
+	var updates map[string]*ipn.OutgoingFile
+	p.mu.Lock()
+	if p.pending == nil {
+		p.pending = make(map[string]*ipn.OutgoingFile)
+	}
+	copy := file
